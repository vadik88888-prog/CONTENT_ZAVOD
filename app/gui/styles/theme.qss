/* Content Factory — approved orange creator-tech Desktop theme.
   Every palette value resolves from app.gui.styles.tokens. */

* {
  color: @PRIMARY_TEXT@;
  /* Arial is present on supported Windows installations and keeps Cyrillic
     project names/local paths legible even in a clean Qt environment. */
  font-family: Arial;
  font-size: 14px;
}

QMainWindow,
QWidget#appShell,
QWidget#screen,
QStackedWidget#contentStack,
QScrollArea {
  background: @APP_BG@;
}

QFrame#sidebar {
  background: @SIDEBAR@;
  border-right: 1px solid @BORDER@;
}

QFrame#brand { background: transparent; border: 0; }
QLabel#brandContent {
  color: @PRIMARY_TEXT@;
  font-size: 20px;
  font-weight: 700;
  letter-spacing: 1px;
}
QLabel#brandFactory {
  color: @APP_BG@;
  background: @PRIMARY@;
  font-size: 20px;
  font-weight: 700;
  letter-spacing: 1px;
  padding: 0 4px;
}
QLabel#brandContent[compactBrand="true"],
QLabel#brandFactory[compactBrand="true"] {
  font-size: 16px;
  letter-spacing: 0;
}
QLabel#systemStatusTitle { color: @SUCCESS@; font-weight: 600; }
QLabel#eyebrow { color: @PRIMARY@; font-size: 11px; font-weight: 700; letter-spacing: 1px; }

QFrame#card,
QFrame#dropZone,
QFrame#preview,
QFrame#settingsProductionPreview,
QFrame#setup-card,
QFrame#setupSourceSummary,
QFrame#setupSummary,
QFrame#processingSummary,
QFrame#processingStages,
QFrame#reviewListPanel,
QFrame#reviewPreviewPanel,
QFrame#reviewInspectorPanel,
QFrame#resultsMetrics,
QFrame#finalOutputList,
QFrame#finalInfo,
QFrame#finalSummary,
QFrame#finalActionBar,
QFrame#resultsStepper,
QFrame#secondaryDetails {
  background: @ELEVATED@;
  border: 1px solid @BORDER@;
  border-radius: 12px;
}

QFrame#dropZone {
  min-height: 132px;
  background: @MAIN@;
  border: 1px dashed @MUTED@;
  border-radius: 12px;
}
QFrame#dropZone:hover { border-color: @PRIMARY@; background: @ACCENT@; }
QLabel#dropZoneIcon { color: @PRIMARY@; font-size: 34px; font-weight: 300; }
QFrame#sourceDivider { color: @BORDER@; }

QFrame#workflowStepper {
  background: @SIDEBAR@;
  border: 1px solid @BORDER@;
  border-radius: 12px;
}

QLabel#workflowStep {
  color: @MUTED@;
  padding: 7px 4px;
  font-weight: 600;
  border-radius: 7px;
}
QLabel#workflowStep[stepState="done"] { color: @SUCCESS@; }
QLabel#workflowStep[stepState="current"] {
  color: @PRIMARY_TEXT@;
  background: @ACCENT@;
  border: 1px solid @PRIMARY@;
}
QLabel#workflowDivider { color: @MUTED@; font-size: 19px; padding: 0 2px; }
QLabel#flowScreenTitle { color: @PRIMARY_TEXT@; font-size: 22px; font-weight: 700; }

QLabel#title { color: @PRIMARY_TEXT@; font-size: 27px; font-weight: 700; }
QLabel#screenTitle { color: @PRIMARY_TEXT@; font-size: 25px; font-weight: 700; }
QLabel#subtitle { color: @SECONDARY@; font-size: 15px; }
QLabel#muted { color: @MUTED@; }
QLabel#warning { color: @WARNING@; }
QLabel#status {
  color: @SUCCESS@;
  background: @ACCENT@;
  border: 1px solid @BORDER@;
  border-radius: 9px;
  padding: 4px 9px;
}

QPushButton {
  background: @ELEVATED@;
  border: 1px solid @BORDER@;
  border-radius: 8px;
  color: @PRIMARY_TEXT@;
  min-height: 20px;
  padding: 8px 12px;
}
QPushButton:hover { background: @ACCENT@; border-color: @SECONDARY@; }
QPushButton:pressed { background: @MAIN@; }
QPushButton:disabled { color: @MUTED@; background: @MAIN@; border-color: @BORDER@; }
QPushButton:focus, QComboBox:focus, QLineEdit:focus, QCheckBox:focus {
  border: 1px solid @PRIMARY@;
  outline: none;
}

QPushButton#primary {
  color: @APP_BG@;
  background: @PRIMARY@;
  border: 1px solid @PRIMARY@;
  font-weight: 700;
}
QPushButton#primary:hover { background: @PRIMARY_HOVER@; border-color: @PRIMARY_HOVER@; }
QPushButton#primary:pressed { background: @PRIMARY@; }
QPushButton#primary:disabled { color: @MUTED@; background: @ACCENT@; border-color: @BORDER@; }

QPushButton#secondaryAction,
QPushButton[secondaryAction="true"] { background: @MAIN@; border-color: @BORDER@; }
QPushButton#secondaryAction:hover,
QPushButton[secondaryAction="true"]:hover { background: @ACCENT@; border-color: @PRIMARY_HOVER@; }
QPushButton#danger { color: @ERROR@; background: @MAIN@; border-color: @ERROR@; }
QPushButton#danger:hover { color: @PRIMARY_TEXT@; background: @ACCENT@; border-color: @ERROR@; }

QPushButton#nav {
  background: transparent;
  border: 1px solid transparent;
  color: @SECONDARY@;
  text-align: left;
  border-radius: 8px;
  padding: 10px 10px;
}
QPushButton#nav:hover { background: @ELEVATED@; color: @PRIMARY_TEXT@; }
QPushButton#nav:checked { color: @PRIMARY_TEXT@; background: @ACCENT@; border-color: @PRIMARY@; }
QPushButton#navNewProject {
  color: @APP_BG@;
  background: @PRIMARY@;
  border: 1px solid @PRIMARY@;
  font-weight: 700;
}
QPushButton#navNewProject:hover { color: @APP_BG@; background: @PRIMARY_HOVER@; border-color: @PRIMARY_HOVER@; }

QLineEdit,
QComboBox,
QTextEdit,
QPlainTextEdit {
  background: @SIDEBAR@;
  border: 1px solid @BORDER@;
  border-radius: 8px;
  color: @PRIMARY_TEXT@;
  padding: 8px 10px;
  selection-background-color: @PRIMARY@;
}
QLineEdit:disabled,
QComboBox:disabled { color: @MUTED@; background: @MAIN@; }
QComboBox::drop-down { border: 0; width: 24px; }
QComboBox::down-arrow { image: none; border: solid @SECONDARY@; border-width: 0 1px 1px 0; width: 6px; height: 6px; transform: rotate(45deg); }
QComboBox QAbstractItemView { background: @ELEVATED@; border: 1px solid @BORDER@; selection-background-color: @ACCENT@; }
QCheckBox { spacing: 8px; color: @SECONDARY@; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid @BORDER@; border-radius: 4px; background: @SIDEBAR@; }
QCheckBox::indicator:checked { background: @PRIMARY@; border-color: @PRIMARY@; }

QProgressBar {
  background: @APP_BG@;
  border: 1px solid @BORDER@;
  border-radius: 5px;
  min-height: 8px;
  max-height: 8px;
}
QProgressBar::chunk { background: @PRIMARY@; border-radius: 4px; }
QLabel#progressValue { color: @PRIMARY@; font-size: 18px; font-weight: 700; }

QScrollArea { border: 0; }
QScrollArea > QWidget,
QScrollArea > QWidget > QWidget { background: @APP_BG@; }
QScrollArea QLabel { background: transparent; }
QScrollArea::viewport { background: transparent; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 3px 0; }
QScrollBar::handle:vertical { background: @BORDER@; min-height: 24px; border-radius: 4px; }
QScrollBar::handle:vertical:hover { background: @MUTED@; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QFrame#recommendationBanner {
  background: @ACCENT@;
  border: 1px solid @BORDER@;
  border-radius: 10px;
}
QLabel#recommendationIcon { color: @PRIMARY@; font-size: 23px; }
QFrame#setupChoiceSection {
  background: @MAIN@;
  border: 1px solid @BORDER@;
  border-radius: 10px;
}
QLabel#setupSectionTitle,
QLabel#inspectorSectionTitle { color: @PRIMARY_TEXT@; font-size: 15px; font-weight: 700; }
QPushButton#setupChoice {
  min-height: 26px;
  background: @SIDEBAR@;
  border: 1px solid @BORDER@;
  text-align: left;
  padding: 6px 8px;
}
QPushButton#setupChoice:hover { border-color: @PRIMARY@; background: @ACCENT@; }
QPushButton#setupChoice:checked,
QPushButton#setupChoice[selected="true"] {
  background: @ACCENT@;
  border: 2px solid @PRIMARY@;
  color: @PRIMARY_TEXT@;
}
QPushButton#choiceMore {
  color: @SECONDARY@;
  background: transparent;
  border: 0;
  padding: 4px 0;
}
QFrame#setupExample {
  background: @SIDEBAR@;
  border: 1px solid @BORDER@;
  border-radius: 18px;
}
QLabel#setupExampleCaption { padding: 8px; }
QFrame#stickyActionBar, QFrame#secondaryActionBar {
  background: @SIDEBAR@;
  border: 1px solid @BORDER@;
  border-radius: 11px;
}

QFrame#processingStages { background: @MAIN@; }
QLabel#processingStage { padding: 8px 2px; color: @MUTED@; border-bottom: 1px solid @BORDER@; }
QLabel#processingStage[stageState="done"] { color: @SUCCESS@; }
QLabel#processingStage[stageState="active"] { color: @PRIMARY_TEXT@; font-weight: 600; }

QFrame#reviewListPanel,
QFrame#reviewPreviewPanel,
QFrame#reviewInspectorPanel { background: @SIDEBAR@; }
QFrame#resultsMetrics { background: @MAIN@; }
QFrame#reviewFilters,
QFrame#momentSelectionToolbar { background: transparent; border: 0; }
QFrame#card[activeCandidate="true"] {
  background: @ACCENT@;
  border: 1px solid @PRIMARY@;
}
QFrame#card[candidateBlocked="true"] { background: @MAIN@; }
QLabel#momentState {
  color: @SECONDARY@;
  background: @MAIN@;
  border: 1px solid @BORDER@;
  border-radius: 7px;
  font-size: 11px;
  font-weight: 700;
  padding: 3px 7px;
}
QLabel#momentState[surfacingState="RECOMMENDED"] { color: @PRIMARY@; border-color: @PRIMARY@; }
QLabel#momentState[surfacingState="AVAILABLE"] { color: @SUCCESS@; border-color: @SUCCESS@; }
QLabel#momentState[surfacingState="BLOCKED"] { color: @MUTED@; }
QLabel#candidateBlockedReason { color: @MUTED@; font-size: 12px; }
QPushButton[candidateAction="true"] {
  min-height: 18px;
  padding: 6px 8px;
}
QFrame#draftInspector {
  background: @MAIN@;
  border: 1px solid @BORDER@;
  border-radius: 10px;
}

QWidget#phoneStage { background: @APP_BG@; border: 1px solid @BORDER@; border-radius: 16px; }
QLabel#active-candidate { color: @PRIMARY_TEXT@; }
QLabel#previewBadge,
QLabel#creativePreviewStatus,
QLabel#finalPreviewStatus {
  color: @SUCCESS@;
  background: @MAIN@;
  border: 1px solid @SUCCESS@;
  border-radius: 7px;
  font-size: 11px;
  font-weight: 700;
  padding: 3px 7px;
}
QLabel#previewBadge[badgeState="warning"],
QLabel#creativePreviewStatus[badgeState="warning"],
QLabel#finalPreviewStatus[badgeState="warning"] {
  color: @WARNING@;
  border-color: @WARNING@;
}
QPushButton[finalAction="true"] { padding: 7px 9px; }
QLabel#candidateThumbnail,
QLabel#finalThumbnail,
QLabel#projectPoster,
QLabel#videoPoster {
  background: @APP_BG@;
  border: 1px solid @BORDER@;
  border-radius: 6px;
  color: @SECONDARY@;
}
QLabel#projectPoster { border-radius: 9px; }

QFrame#finalOutputCard { background: @MAIN@; border: 1px solid @BORDER@; border-radius: 10px; }
QFrame#finalOutputCard:hover { background: @ELEVATED@; border-color: @SECONDARY@; }
QFrame#finalOutputCard[activeFinalOutput="true"] { background: @ACCENT@; border: 1px solid @PRIMARY@; }
QLabel#finalReady { color: @SUCCESS@; }
QLabel#finalSummaryValue { color: @PRIMARY_TEXT@; font-size: 22px; font-weight: 700; }
QLabel#resultsStep { color: @SECONDARY@; }
QLabel#resultsStepActive { color: @PRIMARY_TEXT@; font-weight: 700; }
QFrame#finalWarnings { background: @ACCENT@; border: 1px solid @WARNING@; border-radius: 8px; }

QSlider::groove:horizontal { height: 5px; background: @BORDER@; border-radius: 2px; }
QSlider::sub-page:horizontal { background: @PRIMARY@; border-radius: 2px; }
QSlider::handle:horizontal { background: @PRIMARY_TEXT@; width: 12px; margin: -4px 0; border-radius: 6px; }

QToolTip { background: @ELEVATED@; border: 1px solid @BORDER@; color: @PRIMARY_TEXT@; padding: 5px; }
